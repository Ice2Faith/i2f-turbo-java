        </context>
    </template>
    <template name="#sharp" value="#sharp($CNT$)$END$" toReformat="false" toShortenFQNames="true">
        <variable name="CNT" expression="" defaultValue="" alwaysStopAt="true"/>
        <context>
            <option name="Funvi" value="true"/>
