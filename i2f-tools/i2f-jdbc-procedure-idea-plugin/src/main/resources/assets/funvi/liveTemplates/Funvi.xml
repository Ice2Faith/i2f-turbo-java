<templateSet group="Funvi">
    <template name="#else" value="#else($COND$)&#10;    $END$&#10;##" toReformat="false" toShortenFQNames="true">
        <variable name="COND" expression="" defaultValue="" alwaysStopAt="true"/>
        <context>
            <option name="Funvi" value="true"/>
        </context>
    </template>
    <template name="#for" value="#for(${$BEGIN$},${$COND$},${$INCR$})&#10;    $END$&#10;##" toReformat="false"
              toShortenFQNames="true">
        <variable name="BEGIN" expression="" defaultValue="&quot;i=0&quot;" alwaysStopAt="true"/>
        <variable name="COND" expression="" defaultValue="&quot;i&lt;10&quot;" alwaysStopAt="true"/>
        <variable name="INCR" expression="" defaultValue="&quot;i++&quot;" alwaysStopAt="true"/>
        <context>
            <option name="Funvi" value="true"/>
        </context>
    </template>
    <template name="#foreach" value="#foreach($ITEM$,${$COND$})&#10;    $END$&#10;##" toReformat="false"
              toShortenFQNames="true">
        <variable name="ITEM" expression="" defaultValue="&quot;item&quot;" alwaysStopAt="true"/>
        <variable name="COND" expression="" defaultValue="&quot;list&quot;" alwaysStopAt="true"/>
        <context>
            <option name="Funvi" value="true"/>
        </context>
    </template>
    <template name="#if" value="#if(${$COND$})&#10;    $END$&#10;#else($EL_COND$)&#10;    &#10;##" toReformat="false"
